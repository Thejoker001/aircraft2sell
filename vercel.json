{
  "cleanUrls": false,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron-jobs?job=alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-jobs?job=expire",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin-a2s00760.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/footer.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/icons.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/nav.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/mobile.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/sitemap-(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=UTF-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.aircraft2sell.eu"
        }
      ],
      "destination": "https://aircraft2sell.eu/:path*",
      "permanent": true
    },
    {
      "source": "/homepage.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tarifs",
      "destination": "/pricing.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/guide",
      "destination": "/guide-acheteur.html",
      "permanent": true
    },
    {
      "source": "/annonces",
      "destination": "/search.html",
      "permanent": true
    },
    {
      "source": "/vendre",
      "destination": "/post-listing.html",
      "permanent": true
    },
    {
      "source": "/carte",
      "destination": "/map.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/pro",
      "destination": "/pro-dealers.html",
      "permanent": true
    },
    {
      "source": "/professionnels",
      "destination": "/pro-dealers.html",
      "permanent": true
    },
    {
      "source": "/supabase_setup.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/migration_supabase.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/migration_pseudo.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_setup_secure.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_admin_policies_email.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_analytics.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_analytics_rls.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_seller_rating.sql",
      "destination": "/404.html",
      "permanent": true
    },
    {
      "source": "/supabase_storage_setup.sql",
      "destination": "/404.html",
      "permanent": true
    }
  ]
}
