{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/nav.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/mobile.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=UTF-8" }]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/homepage.html", "permanent": true },
    { "source": "/index.html", "destination": "/homepage.html", "permanent": true },
    { "source": "/tarifs", "destination": "/pricing.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/faq", "destination": "/faq.html", "permanent": true },
    { "source": "/guide", "destination": "/guide-acheteur.html", "permanent": true },
    { "source": "/annonces", "destination": "/search.html", "permanent": true },
    { "source": "/vendre", "destination": "/post-listing.html", "permanent": true },
    { "source": "/carte", "destination": "/map.html", "permanent": true },
    { "source": "/blog", "destination": "/blog.html", "permanent": true },
    { "source": "/supabase_setup.sql", "destination": "/404.html", "permanent": true }
  ]
}
